# =========================================
# PROMPT FILTER ENVIRONMENT CONFIGURATION
# =========================================

# =========================================
# GENERAL
# =========================================
APP_NAME=prompt-filter
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json


# =========================================
# GATEWAY / SSL
# =========================================
SSL_CERT_DAYS=365
SSL_CERT_COUNTRY=RU
SSL_CERT_STATE=Moscow
SSL_CERT_LOCALITY=Moscow
SSL_CERT_ORG=prompt-filter
SSL_CERT_COMMON_NAME=localhost


# =========================================
# FILTERING SERVICE
# =========================================
FILTERING_URL=http://filtering:8000/v1/chat
ENABLE_RULE_DETECTION=true
ENABLE_HEURISTICS=true
ENABLE_REWRITE=true
ML_MODEL=tfidf_logreg
ENABLE_FILTER_OVERRIDES=true


# =========================================
# DATASETS
# =========================================
HF_HOME=/app/datasets/cache/huggingface
HF_DATASETS_CACHE=/app/datasets/cache/huggingface/datasets
TRAIN_DATASET_PATH=/app/datasets/splits/train.csv
VALIDATION_DATASET_PATH=/app/datasets/splits/validation.csv
TEST_DATASET_PATH=/app/datasets/splits/test.csv


# =========================================
# ML TRAINING
# =========================================

# none | sklearn | transformers
ML_BACKEND=sklearn

# scikit-learn classifier
CLASSIFIER_MODEL_PATH=/app/models/classifier/prompt_injection_classifier.joblib

# Transformers classifier
TRANSFORMERS_MODEL_NAME=distilbert-base-multilingual-cased
TRANSFORMERS_MODEL_PATH=/app/models/transformers_prompt_injection
TRANSFORMERS_MAX_LENGTH=256


# =========================================
# LLM SERVICE
# =========================================

# true  - /v1/chat filters and forwards allowed requests to LLM
# false - /v1/chat only filters and returns decision/risk/reasons
LLM_ENABLED=true

LLM_PROVIDER=localllm
LLM_URL=http://localllm:8001
LLM_API_TIMEOUT=30

LLM_API_KEY=
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
LLM_MODEL_PATH=
LLM_DEVICE=auto

# =========================================
# PROMETHEUS / GRAFANA / LOKI
# =========================================
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
LOKI_URL=http://loki:3100
GRAFANA_PORT=3000
